# Copie para .env.local e preencha: cp .env.example .env.local
# `.env.local` nunca vai para o git. Todas as vars abaixo são opcionais na F1:
# sem elas, a bio funciona estática (links + WhatsApp + concierge em modo roteiro).

# URL do projeto Supabase (painel do seu projeto). Liga: painel /admin, contatos, cliques e o keepalive.
# A integração da Vercel grava NEXT_PUBLIC_SUPABASE_URL no lugar deste nome. A bio aceita os dois.
SUPABASE_URL=

# Chave de servidor do mesmo projeto. Liga: escrita do painel, dos contatos e dos cliques.
# Nunca exponha no client: só route handlers a importam.
# A integração da Vercel grava SUPABASE_SECRET_KEY no lugar deste nome. A bio aceita os dois.
# Projeto novo: use a "Secret key" (sb_secret_...) em Project Settings > API Keys.
# Projeto antigo: a chave service_role (JWT, começa com eyJ) também funciona.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo das sessões do painel /admin (32 caracteres ou mais). Gere com: openssl rand -base64 48
# Liga: login no /admin (junto com SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY).
ADMIN_SESSION_SECRET=

# Opcional. Protege GET /api/keepalive (a cron diária do vercel.json que impede o Supabase grátis de
# pausar após 7 dias sem uso). Com ela definida na Vercel, a rota só aceita a chamada da própria cron
# (a Vercel manda "Authorization: Bearer <CRON_SECRET>" sozinha). Sem ela, a rota fica aberta, o que é
# inofensivo: só grava um horário numa tabela própria. Gere com: openssl rand -base64 32
CRON_SECRET=

# --- Onboarding (opcional): ler o seu Instagram para escrever a bio no seu jeito de falar. ---

# Token da sua conta Apify (apify.com). Settings > API & Integrations > Personal API token.
APIFY_TOKEN=

# Chave da Anthropic. Liga o concierge em modo IA (dúvida livre). Sem ela, quem visita vê só o roteiro.
ANTHROPIC_API_KEY=

# Opcional. ID do Pixel da Meta (só números, 10 a 20). A bio lê features.pixel.meta
# (arquivo ou painel, em Contato e site). Esta variável só vale se aquele campo estiver vazio.
META_PIXEL_ID=

# Opcional. ID de medição do Google Analytics 4 (G- e letras ou números). A bio lê
# features.pixel.ga4. Esta variável só vale se aquele campo estiver vazio.
GA4_MEASUREMENT_ID=

# --- Contato do bloco lead (opcional). Sem isto, o contato fica só no banco. ---

# Webhook de contato novo (n8n, Make, Zapier). Opcional: a cada envio do bloco lead, o servidor
# manda um POST com nome, WhatsApp, e-mail e o formulário. Sem isto, o contato fica só no banco.
LEAD_WEBHOOK_URL=

# Chave da Resend (resend.com). Envia o código de 6 dígitos para entrar no /admin
# e, com LEAD_EMAIL_PARA, avisa o dono a cada contato novo.
# O remetente padrão (onboarding@resend.dev) só entrega no e-mail da própria conta Resend:
# use o mesmo e-mail no painel e na conta. Sem domínio para verificar.
RESEND_API_KEY=

# Opcional. Remetente do código (e do aviso de contato), depois de verificar um domínio na Resend.
# Sem isto, o envio usa onboarding@resend.dev.
EMAIL_FROM=

# E-mail de quem recebe o aviso de contato novo. Só é preciso se RESEND_API_KEY estiver preenchida.
LEAD_EMAIL_PARA=

# Remetente só do aviso de contato. Vazio: usa EMAIL_FROM, senão Bio <onboarding@resend.dev>.
LEAD_EMAIL_DE=

# Aviso de versão nova no `npm run check` (opcional). Endereço que devolve JSON { versao, notas? }.
# Vazio = o check lê o versao.json do repositório de distribuição e, se ele não responder,
# a tag mais nova do remote git `upstream`. Sem rede, ou sem resposta em 2 segundos, segue em silêncio (nunca vira erro).
LINKBIO_VERSAO_URL=

# Ping diário de versão (opcional), junto com a cron do keepalive. Vazio = desligado.
# Ligado, a cron faz um POST com { site, versao, fonte, motivo }: o endereço público da bio,
# a versão do template, se a config veio do banco ou do arquivo, e o motivo quando veio do arquivo.
# Aponte para o hub: https://<hub>/api/frota. Não envia o conteúdo da bio nem chave nenhuma.
# Se o endereço não responder, a cron do banco segue normal.
LINKBIO_PING_URL=

# Hub da frota (um deploy só, não a bio de cada pessoa). 1 = esta instância recebe POST /api/frota.
# Sem isto, a rota responde 404. Precisa do mesmo Supabase desta instância (tabela frota_ping, migration 0008).
FROTA_RECEPCAO=

